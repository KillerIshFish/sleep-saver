    <string name="settings_wake_dialog_body">Your schedule, wake zone and morning reminders start from this time.</string>
    <string name="settings_bedtime_dialog_body">Your wind-down, melatonin window and evening reminders are timed from this.</string>
    <string name="settings_mode_from_data">From my sleep data</string>
    <string name="settings_mode_from_data_wake_body">Follows when your watch sees you wake up. Weekdays and weekends are learned separately.</string>
