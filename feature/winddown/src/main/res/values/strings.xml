    <!-- Body scan -->
    <string name="winddown_scan_order">Feet → legs → hips → belly → chest → hands and arms → shoulders → neck and jaw → face → whole body</string>
    <!-- The time per area follows steps.bodyScanStep (whole minutes). -->
    <plurals name="winddown_scan_intro">
        <item quantity="one">About a minute on each area. One gentle pulse means it\'s time to move on.</item>
        <item quantity="other">About %1$d minutes on each area. One gentle pulse means it\'s time to move on.</item>
    </plurals>
    <string name="winddown_scan_1">Notice your feet. Let them be heavy.</string>
    <string name="winddown_scan_2">Your lower legs. Nothing to change.</string>
    <string name="winddown_scan_3">Knees and thighs, resting.</string>
    <string name="winddown_scan_4">Hips and lower back, sinking a little.</string>
    <string name="winddown_scan_5">Your belly, rising and falling.</string>
    <string name="winddown_scan_6">Chest and breath, easy.</string>
    <string name="winddown_scan_7">Hands and arms, loose.</string>
    <string name="winddown_scan_8">Shoulders, dropping away from your ears.</string>
    <string name="winddown_scan_9">Neck and jaw, soft.</string>
    <string name="winddown_scan_10">Face and scalp. Then your whole body, resting.</string>

