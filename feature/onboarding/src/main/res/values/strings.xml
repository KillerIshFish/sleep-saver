    <string name="onboarding_app_name">Sleep Saver</string>

    <!-- Step 1: welcome -->
    <string name="onboarding_welcome_tagline">Know what your sleep owes you, and plan your day around your energy.</string>
    <string name="onboarding_value_debt_title">Sleep debt you can act on</string>
    <string name="onboarding_value_debt_body">See the hours you\'re short and how fast steady nights pay them back.</string>
    <string name="onboarding_value_energy_title">An energy schedule for your day</string>
    <string name="onboarding_value_energy_body">Your peaks and dips, worked out from the nights your watch records.</string>
    <string name="onboarding_value_habits_title">Gentle habit reminders</string>
    <string name="onboarding_value_habits_body">Quiet nudges for light, caffeine and winding down, right on time.</string>
    <string name="onboarding_privacy_line">Your data stays on this phone. No account, no cloud.</string>
    <string name="onboarding_privacy_link">Privacy policy</string>
    <string name="onboarding_get_started">Get started</string>

    <!-- Step 2: connect -->
    <string name="onboarding_flow_watch">Garmin</string>
    <string name="onboarding_flow_health_connect">Health Connect</string>
    <string name="onboarding_flow_app">Sleep Saver</string>

    <string name="onboarding_checking">Checking Health Connect…</string>

    <string name="onboarding_connect_title">Connect your sleep</string>
    <string name="onboarding_connect_body">Garmin Connect saves your nights to Health Connect, and Sleep Saver reads them from there. It only reads: nothing is written back or sent anywhere.</string>
    <string name="onboarding_ask_title">What we\'ll ask to read</string>
    <string name="onboarding_ask_sleep">Sleep</string>
    <string name="onboarding_ask_sleep_body">Required. Your nights, sleep stages and naps.</string>
    <string name="onboarding_ask_heart">Heart rate, HRV and steps</string>
    <string name="onboarding_ask_heart_body">Optional. Extra context on how you slept.</string>
    <string name="onboarding_ask_history">More than 30 days of history</string>
    <string name="onboarding_ask_history_body">Optional. Brings in up to a year of nights at once.</string>
    <string name="onboarding_ask_background">Background sync</string>
    <string name="onboarding_ask_background_body">Optional. New nights arrive without opening the app.</string>
    <string name="onboarding_connect_action">Connect Health Connect</string>

    <string name="onboarding_missing_title">Get Health Connect first</string>
    <string name="onboarding_missing_body">Garmin Connect shares your sleep through Health Connect, a free app from Google. Install it, then come back here: we\'ll pick up where you left off.</string>
    <string name="onboarding_missing_action">Install Health Connect</string>

    <string name="onboarding_update_title">Health Connect needs an update</string>
    <string name="onboarding_update_body">The version on this phone is too old for Sleep Saver. Update it in the Play Store, then come back here.</string>
    <string name="onboarding_update_action">Update Health Connect</string>

    <string name="onboarding_unsupported_title">Health Connect isn\'t available here</string>
    <string name="onboarding_unsupported_body">This phone can\'t run Health Connect, so Sleep Saver can\'t read your Garmin sleep. You can still look around with a month of realistic sample nights.</string>

    <string name="onboarding_denied_title">Sleep access is off</string>
    <string name="onboarding_denied_body">Sleep Saver needs to read your sleep to work out your debt and your day. If no window appeared, open Health Connect, go to App permissions, pick Sleep Saver and turn on Sleep.</string>
    <string name="onboarding_try_again">Try again</string>
    <string name="onboarding_open_health_connect">Open Health Connect</string>

    <string name="onboarding_connected_title">You\'re connected</string>
    <string name="onboarding_connected_body">Here\'s what Sleep Saver can read. You can change this any time in Health Connect.</string>

    <!-- Permission rows -->
    <string name="onboarding_perm_sleep">Sleep</string>
    <string name="onboarding_perm_sleep_granted">Allowed. This is all Sleep Saver strictly needs.</string>
    <string name="onboarding_perm_sleep_missing">Off. Sleep Saver can\'t work without it.</string>
    <string name="onboarding_perm_heart">Heart rate, HRV and steps</string>
    <string name="onboarding_perm_heart_granted">Allowed. Adds context to each night.</string>
    <string name="onboarding_perm_heart_missing">Not allowed. Heart extras stay hidden.</string>
    <string name="onboarding_perm_history">More than 30 days of history</string>
    <string name="onboarding_perm_history_granted">Allowed. Up to a year of nights comes in.</string>
    <string name="onboarding_perm_history_missing">Not allowed. We start from the last 30 days.</string>
    <string name="onboarding_perm_history_unavailable">Not available on this phone. We start from the last 30 days.</string>
    <string name="onboarding_perm_background">Background sync</string>
    <string name="onboarding_perm_background_granted">Allowed. New nights arrive on their own.</string>
    <string name="onboarding_perm_background_missing">Not allowed. New nights arrive when you open the app.</string>
    <string name="onboarding_perm_background_unavailable">Not available on this phone. New nights arrive when you open the app.</string>
    <string name="onboarding_allow">Allow</string>
    <string name="onboarding_manage_in_health_connect">Manage in Health Connect</string>

    <!-- Sleep source (Garmin) check -->
    <string name="onboarding_source_checking">Looking for Garmin sleep in Health Connect…</string>
    <string name="onboarding_source_garmin_ok">Garmin Connect is sharing sleep</string>
    <string name="onboarding_source_garmin_ok_body">Nights from your watch will flow in by themselves.</string>
    <string name="onboarding_source_other_ok">Using %1$s for sleep</string>
    <string name="onboarding_source_other_ok_body">You can switch back to Garmin Connect in Settings.</string>
    <string name="onboarding_source_all_ok">Using sleep from all your apps</string>
    <string name="onboarding_source_all_ok_body">When two apps record the same night, Garmin\'s version wins.</string>
    <string name="onboarding_source_garmin_missing">No Garmin sleep yet</string>
    <string name="onboarding_source_garmin_missing_body">Garmin Connect hasn\'t shared any sleep with Health Connect in the last 30 days. To turn it on:</string>
    <string name="onboarding_source_other_missing">No sleep from %1$s yet</string>
    <string name="onboarding_source_other_missing_body">Make sure %1$s is allowed to write sleep to Health Connect, then sync it.</string>
    <string name="onboarding_source_all_missing">No sleep in Health Connect yet</string>
    <string name="onboarding_garmin_step_1">Open Garmin Connect and tap More.</string>
    <string name="onboarding_garmin_step_2">Go to Settings, then Connected apps, then Health Connect.</string>
    <string name="onboarding_garmin_step_3">Allow Sleep, then sync your watch.</string>
    <string name="onboarding_open_garmin">Open Garmin Connect</string>
    <string name="onboarding_get_garmin">Get Garmin Connect</string>
    <string name="onboarding_check_again">Check again</string>
