    <string name="ss_habit_morning_light_body">Get daylight in your eyes soon after waking to set your body clock.</string>
    <string name="ss_habit_caffeine_cutoff_body">Caffeine after this can still be working when you try to sleep.</string>
    <string name="ss_habit_large_meal_cutoff_body">Finish heavy meals by now so digestion settles before bed.</string>
    <string name="ss_habit_alcohol_cutoff_body">Drinks close to bed make sleep lighter and more broken.</string>
    <string name="ss_habit_exercise_cutoff_body">Keep intense workouts before this so your body can cool down.</string>
    <string name="ss_habit_dim_lights_body">Turn down lights and screens to help sleepiness arrive.</string>
    <string name="ss_habit_evening_routine_body">Start the calming activities you picked for tonight.</string>
    <string name="ss_habit_bedtime_body">Head to bed now to catch your easiest window for falling asleep.</string>
    <string name="ss_habit_nap_window_body">If you need a nap, take it now and keep it under 30 minutes.</string>

