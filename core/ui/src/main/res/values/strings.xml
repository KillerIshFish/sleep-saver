    <string name="ss_phase_grogginess_body">Your body is still shaking off sleep. Go easy on hard decisions.</string>
    <string name="ss_phase_morning_peak_body">Alert and clear-headed. A good slot for focused work.</string>
    <string name="ss_phase_afternoon_dip_body">Energy naturally sags. Fine for light tasks, a walk or a short nap.</string>
    <string name="ss_phase_evening_peak_body">A second wind. Good for exercise, chores or social plans.</string>
    <string name="ss_phase_wind_down_body">Lower the lights and slow down so sleepiness can build.</string>
    <string name="ss_phase_melatonin_window_body">Your best window to fall asleep easily.</string>

